# Settings read from environment variables (see the README). Never commit real values.
# Only the AI report and chat need a key; everything else works without it.
AI_API_KEY=

# Optional: path to a DB-IP Lite .mmdb file for IP locations (GeoIP is skipped when empty)
GEOIP_DATABASE=
# Optional: your own alert rules file
ALERT_RULES_FILE=

PORT=8080
